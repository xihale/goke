<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="36dp">

    <ProgressBar
        android:id="@+id/today_item_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:indeterminate="false"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/widget_course_progress_drawable"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/today_item_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:orientation="horizontal"
        android:paddingBottom="3dp"
        android:paddingEnd="8dp"
        android:paddingStart="10dp"
        android:paddingTop="3dp">

        <LinearLayout
            android:id="@+id/today_item_time_col"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:minWidth="44dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/today_item_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/today_item_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/today_item_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/widget_accent"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/today_item_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/today_item_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/today_item_remind"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_alarm"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/today_item_repeat"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_repeat"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/today_item_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="80dp"
                    android:textColor="@color/widget_muted"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/today_item_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/today_item_check"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/a11y_mark_done"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_check_box"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
